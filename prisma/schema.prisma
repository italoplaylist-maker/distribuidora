generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// PLATFORM / SUPER ADMIN
// ============================================================

enum UserType {
  SUPER_ADMIN
  COMPANY_USER
}

enum CompanyStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
}

enum TrialBehavior {
  BLOCK_ALL
  READ_ONLY
  BLOCK_NEW_OPERATIONS
}

model Company {
  id            String  @id @default(cuid())
  razaoSocial   String
  nomeFantasia  String
  cnpj          String  @unique
  email         String
  phone         String?
  whatsapp      String?
  zipCode       String?
  address       String?
  addressNumber String?
  neighborhood  String?
  city          String?
  state         String?
  logoUrl       String?

  status        CompanyStatus @default(TRIAL)
  trialBehavior TrialBehavior @default(READ_ONLY)
  trialStartsAt DateTime      @default(now())
  trialEndsAt   DateTime
  suspendedAt   DateTime?
  canceledAt    DateTime?
  cancelReason  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users        User[]
  settings     CompanySettings?
  subscription Subscription?
  payments     Payment[]
  invoices     Invoice[]

  categories Category[]
  brands     Brand[]
  products   Product[]
  suppliers  Supplier[]
  customers  Customer[]

  purchases      Purchase[]
  sales          Sale[]
  stockMovements StockMovement[]
  inventories    Inventory[]

  cashRegisters         CashRegister[]
  accountsPayable       AccountPayable[]
  accountsReceivable    AccountReceivable[]
  financialTransactions FinancialTransaction[]

  deliveries Delivery[]
  drivers    Driver[]
  vehicles   Vehicle[]

  notifications Notification[]
  auditLogs     AuditLog[]

  @@index([status])
  @@map("companies")
}

model CompanySettings {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  requireUniqueBarcode   Boolean @default(true)
  lowStockAlert          Boolean @default(true)
  allowNegativeStock     Boolean @default(false)
  defaultPaymentTermDays Int     @default(30)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("company_settings")
}

// ============================================================
// PLANS & SUBSCRIPTIONS
// ============================================================

model Plan {
  id           String  @id @default(cuid())
  name         String  @unique
  slug         String  @unique
  description  String?
  priceMonthly Decimal @db.Decimal(10, 2)
  priceYearly  Decimal @db.Decimal(10, 2)

  maxUsers     Int
  maxProducts  Int
  maxCustomers Int
  maxSuppliers Int
  maxStorageMb Int

  features  String[] @default([])
  active    Boolean  @default(true)
  sortOrder Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

model Subscription {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  planId    String
  plan      Plan    @relation(fields: [planId], references: [id])

  status             SubscriptionStatus @default(TRIALING)
  billingCycle       String             @default("monthly") // monthly | yearly
  startDate          DateTime           @default(now())
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime
  canceledAt         DateTime?

  paymentProvider        String? // mercadopago | stripe | asaas
  externalSubscriptionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]
  invoices Invoice[]

  @@map("subscriptions")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Payment {
  id             String        @id @default(cuid())
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  amount            Decimal       @db.Decimal(10, 2)
  status            PaymentStatus @default(PENDING)
  provider          String?
  externalPaymentId String?
  method            String?
  paidAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payments")
}

model Invoice {
  id             String        @id @default(cuid())
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  number  String        @unique
  amount  Decimal       @db.Decimal(10, 2)
  status  PaymentStatus @default(PENDING)
  dueDate DateTime
  paidAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("invoices")
}

// ============================================================
// USERS / ROLES / PERMISSIONS
// ============================================================

enum CompanyRole {
  ADMINISTRADOR
  GERENTE
  VENDEDOR
  ESTOQUISTA
  FINANCEIRO
  MOTORISTA
}

model User {
  id        String   @id @default(cuid())
  userType  UserType @default(COMPANY_USER)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name         String
  email        String @unique
  passwordHash String
  role         CompanyRole?
  active       Boolean      @default(true)
  avatarUrl    String?

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  driver        Driver?
  sales         Sale[]         @relation("SaleUser")
  purchases     Purchase[]     @relation("PurchaseUser")
  cashRegisters CashRegister[]
  auditLogs     AuditLog[]
  notifications Notification[]

  @@index([companyId])
  @@map("users")
}

// ============================================================
// CATALOG
// ============================================================

model Category {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("categories")
}

model Brand {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("brands")
}

model Product {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name       String
  sku        String?
  barcode    String?
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  brandId    String?
  brand      Brand?    @relation(fields: [brandId], references: [id])

  unit        String  @default("UN")
  cost        Decimal @default(0) @db.Decimal(12, 4)
  averageCost Decimal @default(0) @db.Decimal(12, 4)
  price       Decimal @default(0) @db.Decimal(12, 2)

  stock    Decimal @default(0) @db.Decimal(12, 3)
  minStock Decimal @default(0) @db.Decimal(12, 3)
  maxStock Decimal @default(0) @db.Decimal(12, 3)

  photoUrl String?
  active   Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  saleItems      SaleItem[]
  purchaseItems  PurchaseItem[]
  stockMovements StockMovement[]
  inventoryItems InventoryItem[]
  deliveryItems  DeliveryItem[]

  @@unique([companyId, sku])
  @@index([companyId])
  @@index([companyId, barcode])
  @@index([companyId, active])
  @@map("products")
}

// ============================================================
// PARTNERS
// ============================================================

model Supplier {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name     String
  document String?
  phone    String?
  whatsapp String?
  email    String?
  address  String?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases Purchase[]

  @@index([companyId])
  @@map("suppliers")
}

model Customer {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name        String
  document    String?
  phone       String?
  whatsapp    String?
  address     String?
  creditLimit Decimal @default(0) @db.Decimal(12, 2)
  notes       String?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales              Sale[]
  accountsReceivable AccountReceivable[]
  deliveries         Delivery[]

  @@index([companyId])
  @@map("customers")
}

// ============================================================
// PURCHASES
// ============================================================

enum PurchaseStatus {
  PENDING
  RECEIVED
  CANCELED
}

enum PaymentTerm {
  CASH
  CREDIT
}

model Purchase {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  userId     String
  user       User     @relation("PurchaseUser", fields: [userId], references: [id])

  status       PurchaseStatus @default(PENDING)
  paymentTerm  PaymentTerm    @default(CASH)
  totalAmount  Decimal        @default(0) @db.Decimal(12, 2)
  notes        String?
  canceledAt   DateTime?
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items           PurchaseItem[]
  stockMovements  StockMovement[]
  accountsPayable AccountPayable[]

  @@index([companyId])
  @@map("purchases")
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])

  quantity  Decimal @db.Decimal(12, 3)
  unitCost  Decimal @db.Decimal(12, 4)
  totalCost Decimal @db.Decimal(12, 2)

  @@index([purchaseId])
  @@map("purchase_items")
}

// ============================================================
// SALES
// ============================================================

enum SaleStatus {
  COMPLETED
  CANCELED
}

model Sale {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  userId     String
  user       User      @relation("SaleUser", fields: [userId], references: [id])

  status        SaleStatus  @default(COMPLETED)
  paymentTerm   PaymentTerm @default(CASH)
  paymentMethod String      @default("cash") // cash | pix | debit | credit | fiado
  subtotal      Decimal     @default(0) @db.Decimal(12, 2)
  discount      Decimal     @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal     @default(0) @db.Decimal(12, 2)

  canceledAt   DateTime?
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items              SaleItem[]
  stockMovements     StockMovement[]
  accountsReceivable AccountReceivable[]
  cashMovements      CashMovement[]
  deliveries         Delivery[]

  @@index([companyId])
  @@index([companyId, createdAt])
  @@map("sales")
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity   Decimal @db.Decimal(12, 3)
  unitPrice  Decimal @db.Decimal(12, 2)
  totalPrice Decimal @db.Decimal(12, 2)

  @@index([saleId])
  @@map("sale_items")
}

// ============================================================
// STOCK
// ============================================================

enum StockMovementType {
  ENTRADA
  SAIDA
  VENDA
  COMPRA
  AJUSTE
  INVENTARIO
  PERDA
  AVARIA
  DEVOLUCAO
}

model StockMovement {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])

  type         StockMovementType
  quantity     Decimal           @db.Decimal(12, 3) // positive = in, negative = out
  balanceAfter Decimal           @db.Decimal(12, 3)

  saleId      String?
  sale        Sale?      @relation(fields: [saleId], references: [id])
  purchaseId  String?
  purchase    Purchase?  @relation(fields: [purchaseId], references: [id])
  inventoryId String?
  inventory   Inventory? @relation(fields: [inventoryId], references: [id])

  reason    String?
  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([companyId, productId])
  @@map("stock_movements")
}

enum InventoryStatus {
  OPEN
  CLOSED
}

model Inventory {
  id        String          @id @default(cuid())
  companyId String
  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status    InventoryStatus @default(OPEN)
  notes     String?
  createdAt DateTime        @default(now())
  closedAt  DateTime?

  items          InventoryItem[]
  stockMovements StockMovement[]

  @@index([companyId])
  @@map("inventories")
}

model InventoryItem {
  id          String    @id @default(cuid())
  inventoryId String
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id])

  expectedQty Decimal @db.Decimal(12, 3)
  countedQty  Decimal @db.Decimal(12, 3)
  difference  Decimal @db.Decimal(12, 3)

  @@index([inventoryId])
  @@map("inventory_items")
}

// ============================================================
// FINANCE
// ============================================================

enum CashRegisterStatus {
  OPEN
  CLOSED
}

model CashRegister {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id])

  status          CashRegisterStatus @default(OPEN)
  openingBalance  Decimal            @default(0) @db.Decimal(12, 2)
  expectedBalance Decimal            @default(0) @db.Decimal(12, 2)
  informedBalance Decimal?           @db.Decimal(12, 2)
  difference      Decimal?           @db.Decimal(12, 2)

  openedAt DateTime  @default(now())
  closedAt DateTime?

  movements CashMovement[]

  @@index([companyId])
  @@map("cash_registers")
}

enum CashMovementType {
  VENDA
  RECEBIMENTO
  DESPESA
  SANGRIA
  SUPRIMENTO
  ABERTURA
}

model CashMovement {
  id             String       @id @default(cuid())
  cashRegisterId String
  cashRegister   CashRegister @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)
  saleId         String?
  sale           Sale?        @relation(fields: [saleId], references: [id])

  type        CashMovementType
  amount      Decimal          @db.Decimal(12, 2)
  description String?
  createdAt   DateTime         @default(now())

  @@index([cashRegisterId])
  @@map("cash_movements")
}

enum AccountStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  CANCELED
  OVERDUE
}

model AccountPayable {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplierId String?
  purchaseId String?
  purchase   Purchase? @relation(fields: [purchaseId], references: [id])

  description String
  amount      Decimal       @db.Decimal(12, 2)
  paidAmount  Decimal       @default(0) @db.Decimal(12, 2)
  dueDate     DateTime
  status      AccountStatus @default(OPEN)
  paidAt      DateTime?
  canceledAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions FinancialTransaction[]

  @@index([companyId])
  @@index([companyId, status])
  @@map("accounts_payable")
}

model AccountReceivable {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  saleId     String?
  sale       Sale?    @relation(fields: [saleId], references: [id])

  description String
  amount      Decimal       @db.Decimal(12, 2)
  paidAmount  Decimal       @default(0) @db.Decimal(12, 2)
  dueDate     DateTime
  status      AccountStatus @default(OPEN)
  paidAt      DateTime?
  canceledAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions FinancialTransaction[]

  @@index([companyId])
  @@index([companyId, status])
  @@map("accounts_receivable")
}

enum FinancialTransactionType {
  PAYMENT
  RECEIPT
  EXPENSE
  REVENUE
}

model FinancialTransaction {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  type        FinancialTransactionType
  amount      Decimal                  @db.Decimal(12, 2)
  description String?

  accountPayableId    String?
  accountPayable      AccountPayable?    @relation(fields: [accountPayableId], references: [id])
  accountReceivableId String?
  accountReceivable   AccountReceivable? @relation(fields: [accountReceivableId], references: [id])

  createdAt DateTime @default(now())

  @@index([companyId])
  @@map("financial_transactions")
}

// ============================================================
// DELIVERIES
// ============================================================

enum DeliveryStatus {
  PENDING
  IN_ROUTE
  DELIVERED
  FAILED
  CANCELED
}

model Driver {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String? @unique
  user      User?   @relation(fields: [userId], references: [id])

  name   String
  phone  String?
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries Delivery[]
  vehicles   Vehicle[]

  @@index([companyId])
  @@map("drivers")
}

model Vehicle {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  driverId  String?
  driver    Driver? @relation(fields: [driverId], references: [id])

  plate  String
  model  String?
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, plate])
  @@index([companyId])
  @@map("vehicles")
}

model Delivery {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  saleId     String?
  sale       Sale?     @relation(fields: [saleId], references: [id])
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  driverId   String?
  driver     Driver?   @relation(fields: [driverId], references: [id])

  status       DeliveryStatus @default(PENDING)
  address      String?
  photoUrl     String?
  signatureUrl String?
  notes        String?

  scheduledAt DateTime?
  deliveredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items DeliveryItem[]

  @@index([companyId])
  @@map("deliveries")
}

model DeliveryItem {
  id         String   @id @default(cuid())
  deliveryId String
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Decimal  @db.Decimal(12, 3)

  @@index([deliveryId])
  @@map("delivery_items")
}

// ============================================================
// NOTIFICATIONS & AUDIT
// ============================================================

model Notification {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?   @relation(fields: [userId], references: [id])

  title   String
  message String
  type    String  @default("info") // info | warning | danger | success
  read    Boolean @default(false)
  link    String?

  createdAt DateTime @default(now())

  @@index([companyId, userId])
  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(cuid())
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])

  action       String
  entity       String
  entityId     String?
  previousData Json?
  newData      Json?
  ip           String?
  userAgent    String?

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}
